# =============================================================================
# AutoFichas — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha. Nunca versione o arquivo real.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# URL pública da aplicação (usada em links e verificação de origem)
APP_URL=http://localhost:3000
# Segredo para assinar URLs temporárias e tokens. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Duração da sessão em horas
SESSION_TTL_HOURS=12

# --- Banco de dados (PostgreSQL / Supabase) ----------------------------------
# Local:    postgres://usuario:senha@localhost:5432/autofichas
# Supabase: Project Settings → Database → Connection string (URI, modo "Session")
DATABASE_URL=
# Use "true" para conexões que exigem SSL (Supabase, RDS, etc.)
DATABASE_SSL=false

# --- Administrador inicial (usado apenas por `npm run db:seed`) ---------------
ADMIN_NAME=
ADMIN_EMAIL=
# Mínimo de 10 caracteres. Troque após o primeiro acesso.
ADMIN_PASSWORD=

# --- Armazenamento de arquivos ------------------------------------------------
# local    → disco do servidor (diretório privado, fora de /public)
# supabase → Supabase Storage (bucket PRIVADO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Criptografia AES-256-GCM dos arquivos armazenados (recomendado).
# 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se perder esta chave, os arquivos não poderão ser lidos.
STORAGE_ENCRYPTION_KEY=

SUPABASE_URL=
# Chave service_role — somente no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=autofichas-documentos

# --- Inteligência artificial / OCR -------------------------------------------
# anthropic → Claude (multimodal: lê PDFs e imagens nativamente) — recomendado
# openai    → modelos multimodais da OpenAI
# local     → OCR local (Tesseract) + regras; nenhum dado sai do servidor,
#             precisão menor e sem análise visual da foto do veículo
# none      → extração desativada (preenchimento manual)
AI_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Tempo máximo (ms) por chamada ao provedor de IA
AI_TIMEOUT_MS=90000

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_MB=15
MAX_FILES_PER_DOCUMENT=10

# Antivírus opcional (ClamAV / clamd). Se definido, todo upload é escaneado.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Geração de PDF -----------------------------------------------------------
# Caminho opcional para o executável do Chromium (se não usar o do Playwright)
PDF_CHROMIUM_EXECUTABLE=
